# Copy this file to .env and configure one provider.
LLM_PROVIDER=groq

# Optional model override
# LLM_MODEL=llama-3.3-70b-versatile

# Configure the key for your selected provider.
# OPENAI_API_KEY=your_openai_api_key_here
# GROQ_API_KEY=your_groq_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# GOOGLE_API_KEY=your_google_api_key_here

# Optional local Ollama configuration
# OLLAMA_BASE_URL=http://localhost:11434/v1

# Optional Week 2 n8n webhook. Leave unset to use the safe mock.
# WEBHOOK_URL=https://your-n8n-host/webhook/your-workflow
